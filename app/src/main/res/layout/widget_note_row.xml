<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/oui_space_m"
    android:paddingEnd="@dimen/oui_space_m"
    android:paddingTop="@dimen/oui_space_s"
    android:paddingBottom="@dimen/oui_space_s">

    <ImageView
        android:id="@+id/widget_row_color"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="@dimen/oui_space_s"
        android:contentDescription="@string/cd_note_color"
        android:src="@drawable/bg_color_swatch" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/OneNotesTextAppearance.Body"
            android:textColor="@color/onenotes_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_row_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/OneNotesTextAppearance.Caption" />

        <TextView
            android:id="@+id/widget_row_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/OneNotesTextAppearance.Caption" />

    </LinearLayout>

</LinearLayout>
