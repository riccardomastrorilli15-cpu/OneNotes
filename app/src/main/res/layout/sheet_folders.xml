<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/oui_space_m"
    android:paddingEnd="@dimen/oui_space_m"
    android:paddingTop="@dimen/oui_space_s"
    android:paddingBottom="@dimen/oui_space_l">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/oui_space_m"
        android:background="@drawable/bg_chip" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/oui_space_s"
        android:text="@string/action_move_to_folder"
        android:textAppearance="@style/OneNotesTextAppearance.Title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheet_folders_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <TextView
        android:id="@+id/sheet_folder_new"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/oui_space_s"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/oui_space_m"
        android:paddingEnd="@dimen/oui_space_m"
        android:text="@string/action_new_folder"
        android:textAppearance="@style/OneNotesTextAppearance.Body"
        android:textColor="@color/onenotes_primary" />

</LinearLayout>
