<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/choice_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/cd_more_options"
        android:tint="@color/onenotes_text_secondary"
        app:srcCompat="@drawable/ic_folder" />

    <TextView
        android:id="@+id/choice_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/oui_space_m"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/OneNotesTextAppearance.Body"
        android:textColor="@color/onenotes_text_primary" />

    <ImageView
        android:id="@+id/choice_selected"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@string/action_select_all"
        android:tint="@color/onenotes_primary"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_check" />

</LinearLayout>
