<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/oui_space_m"
    android:paddingEnd="@dimen/oui_space_m"
    android:paddingTop="@dimen/oui_space_s"
    android:paddingBottom="@dimen/oui_space_l">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/oui_space_m"
        android:background="@drawable/bg_chip" />

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/oui_space_s"
        android:text="@string/action_more"
        android:textAppearance="@style/OneNotesTextAppearance.Title" />

    <LinearLayout
        android:id="@+id/sheet_actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
