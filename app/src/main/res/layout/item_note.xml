<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/note_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/oui_space_xs"
    android:layout_marginEnd="@dimen/oui_space_xs"
    android:layout_marginTop="@dimen/oui_space_s"
    android:layout_marginBottom="@dimen/oui_space_xs"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/onenotes_surface"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:rippleColor="#1F2E6BF6"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/oui_space_m"
        android:paddingEnd="@dimen/oui_space_m"
        android:paddingTop="@dimen/oui_space_m"
        android:paddingBottom="@dimen/oui_space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/note_title"
                style="@style/OneNotesText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_activity_editor" />

            <ImageView
                android:id="@+id/note_pinned"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/oui_space_xs"
                android:contentDescription="@string/cd_note_pinned"
                android:tint="@color/onenotes_primary"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_pin_filled" />

            <ImageView
                android:id="@+id/note_locked"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/oui_space_xs"
                android:contentDescription="@string/cd_note_locked"
                android:tint="@color/onenotes_text_secondary"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_lock" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/note_selected"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/oui_space_xs"
                app:buttonCompat="@drawable/bg_checkbox"
                app:buttonTint="@color/onenotes_primary"
                android:clickable="false"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/note_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oui_space_xs"
            android:ellipsize="end"
            android:maxLines="4"
            android:textAppearance="@style/OneNotesTextAppearance.Body" />

        <TextView
            android:id="@+id/note_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oui_space_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/OneNotesTextAppearance.Caption"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oui_space_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/note_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/OneNotesTextAppearance.Caption" />

            <ImageView
                android:id="@+id/note_attachment_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/cd_note_attachment"
                android:tint="@color/onenotes_text_secondary"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_file" />

            <ImageView
                android:id="@+id/note_reminder_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/oui_space_s"
                android:contentDescription="@string/action_reminder"
                android:tint="@color/onenotes_text_secondary"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_reminder" />

            <ImageView
                android:id="@+id/note_more"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="@dimen/oui_space_s"
                android:contentDescription="@string/cd_more_options"
                android:tint="@color/onenotes_text_secondary"
                app:srcCompat="@drawable/ic_more_vert" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
