<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/oui_space_m"
        android:layout_marginEnd="@dimen/oui_space_m"
        android:layout_marginTop="@dimen/oui_space_s"
        android:background="@color/onenotes_divider" />

    <TextView
        android:id="@+id/drawer_new_folder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/oui_space_s"
        android:layout_marginEnd="@dimen/oui_space_s"
        android:background="@drawable/bg_drawer_item"
        android:drawablePadding="@dimen/oui_space_m"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/oui_space_m"
        android:paddingEnd="@dimen/oui_space_m"
        android:text="@string/action_new_folder"
        android:textAppearance="@style/OneNotesTextAppearance.Body"
        android:textColor="@color/onenotes_text_primary"
        android:textSize="15sp" />

</LinearLayout>
