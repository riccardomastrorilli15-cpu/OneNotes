<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/oui_space_m"
    android:paddingEnd="@dimen/oui_space_m"
    android:paddingTop="@dimen/oui_space_s"
    android:paddingBottom="@dimen/oui_space_l">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/oui_space_m"
        android:background="@drawable/bg_chip" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/oui_space_s"
        android:text="@string/action_tags"
        android:textAppearance="@style/OneNotesTextAppearance.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/sheet_tag_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:hint="@string/action_add_tag"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:paddingStart="@dimen/oui_space_m"
            android:paddingEnd="@dimen/oui_space_m"
            android:textColor="@color/onenotes_text_primary"
            android:textColorHint="@color/onenotes_text_hint" />

        <ImageButton
            android:id="@+id/sheet_tag_add"
            style="@style/OneNotesToolbarButton"
            android:contentDescription="@string/action_add_tag"
            app:srcCompat="@drawable/ic_add" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheet_tags_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/oui_space_s"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <TextView
        android:id="@+id/sheet_tags_done"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/oui_space_m"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:text="@string/action_done"
        android:textAppearance="@style/OneNotesTextAppearance.Title"
        android:textColor="@color/onenotes_primary" />

</LinearLayout>
