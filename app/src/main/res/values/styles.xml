<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- One UI style bottom sheets: full width, bottom anchored, rounded top. -->
    <style name="OneNotesTheme.BottomSheetDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="OneNotesTheme.AlertDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>

    <!-- Note list -->
    <style name="OneNotesText.Title" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/OneNotesTextAppearance.Title</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="OneNotesText.Body" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/OneNotesTextAppearance.Body</item>
    </style>

    <style name="OneNotesTextAppearance.Title" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/onenotes_text_primary</item>
    </style>

    <style name="OneNotesTextAppearance.Body" parent="TextAppearance.AppCompat.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/onenotes_text_secondary</item>
    </style>

    <style name="OneNotesTextAppearance.Caption" parent="TextAppearance.AppCompat.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/onenotes_text_secondary</item>
    </style>

    <!-- Text based formatting buttons of the editor (B, I, U, S, H1, lists…) -->
    <style name="OneNotesFormatTextButton" parent="android:Widget.TextView">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_toolbar_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/selector_toolbar_icon</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Rounded toolbar buttons used by the editor and the drawing screen -->
    <style name="OneNotesToolbarButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/toolbar_button_size</item>
        <item name="android:layout_height">@dimen/toolbar_button_size</item>
        <item name="android:background">@drawable/bg_toolbar_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/selector_toolbar_icon</item>
    </style>

</resources>
